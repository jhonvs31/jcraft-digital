---
import { nav, contact } from '../data/site';
import { u, wa } from '../lib/url';
import Logo from './Logo.astro';
const { current } = Astro.props as { current: string };
const isActive = (href: string) => current === href || (href === 'blog.html' && current.startsWith('blog/'));
const mobile = [...nav, { href: 'contacto.html', label: 'Contacto' }];
---
<header data-header class="fixed inset-x-0 top-0 z-40 transition-[background-color,backdrop-filter,padding] duration-500">
  <div class="wrap flex items-center justify-between py-5 transition-[padding] duration-500" data-header-inner>
    <a href={u('index.html')} class="relative z-10 shrink-0" aria-label="JCraft Digital, inicio">
      <Logo class="h-10 w-auto sm:h-11" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {nav.slice(1).map((l) => (
        <a href={u(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}
          class:list={['rounded-full px-4 py-2 text-[15px] font-semibold transition hover:text-cyan', isActive(l.href) ? 'text-cyan' : 'text-white/85']}>{l.label}</a>
      ))}
      <a href={u('contacto.html')} class="btn btn-primary ml-3 !py-3" data-magnetic>Hablemos</a>
    </nav>
    <button type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú"
      class="relative z-10 grid h-11 w-11 place-items-center rounded-full border border-white/20 bg-deep/40 backdrop-blur lg:hidden">
      <span class="absolute block h-0.5 w-5 -translate-y-1 bg-white transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)]" data-bar="1"></span>
      <span class="absolute block h-0.5 w-5 translate-y-1 bg-white transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)]" data-bar="2"></span>
    </button>
  </div>
</header>
  <!-- Menú móvil: se abre como un círculo desde el botón y los enlaces entran escalonados; al cerrar, lo mismo al revés. -->
<div id="menu-movil" data-menu hidden class="fixed inset-0 z-[35] overflow-hidden bg-deep lg:hidden" style="clip-path: circle(0px at calc(100% - 42px) 46px)">
  <div class="gridlines absolute inset-0"></div>
  <div class="glow -right-32 -top-32 h-[420px] w-[420px]"></div>
  <nav aria-label="Móvil" class="wrap relative flex h-full flex-col justify-center gap-1">
    {mobile.map((l, i) => (
      <a href={u(l.href)} data-menu-link aria-current={isActive(l.href) ? 'page' : undefined}
        class:list={['flex items-baseline gap-4 py-1 font-display text-5xl font-black tracking-tight transition-colors hover:text-cyan', isActive(l.href) ? 'text-cyan' : 'text-white']}>
        <span class="font-serif text-xl font-normal text-cyan italic">0{i + 1}</span>{l.label}
      </a>
    ))}
    <div data-menu-link class="mt-10 flex flex-wrap gap-3">
      <a href={wa('Hola! Quiero una consulta gratuita.')} target="_blank" rel="noopener" class="btn btn-primary">WhatsApp</a>
      <a href={contact.instagram} target="_blank" rel="noopener" class="btn btn-ghost">Instagram</a>
    </div>
  </nav>
</div>

