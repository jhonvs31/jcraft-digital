---
import { nav } from '../data/site';
import { u } from '../lib/url';
const { current } = Astro.props as { current: string };
const isActive = (href: string) => current === href || (href === 'blog.html' && current.startsWith('blog/'));
---
<header data-header class="fixed inset-x-0 top-0 z-40 transition-[background-color,backdrop-filter,padding] duration-500">
  <div class="wrap flex items-center justify-between py-5 transition-[padding] duration-500" data-header-inner>
    <a href={u('index.html')} class="relative z-10 shrink-0" aria-label="JCraft Digital, inicio">
      <img src={u('assets/logo-white.png')} alt="JCraft Digital" width="150" height="48" class="h-10 w-auto sm:h-11" />
    </a>
    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {nav.slice(1).map((l) => (
        <a href={u(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}
          class:list={['rounded-full px-4 py-2 text-[15px] font-semibold transition hover:text-cyan', isActive(l.href) ? 'text-cyan' : 'text-white/85']}>{l.label}</a>
      ))}
      <a href={u('contacto.html')} class="btn btn-primary ml-3 !py-3" data-magnetic>Hablemos</a>
    </nav>
    <button type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú"
      class="relative z-10 grid h-11 w-11 place-items-center rounded-full border border-white/20 lg:hidden">
      <span class="block h-0.5 w-5 bg-white transition" data-bar></span>
      <span class="absolute block h-0.5 w-5 translate-y-1.5 bg-white transition" data-bar></span>
    </button>
  </div>
  <div id="menu-movil" data-menu hidden class="fixed inset-0 bg-deep/97 backdrop-blur-xl lg:hidden">
    <nav aria-label="Móvil" class="wrap flex h-full flex-col justify-center gap-2">
      {[...nav, { href: 'contacto.html', label: 'Contacto' }].map((l) => (
        <a href={u(l.href)} class="font-display text-5xl font-black tracking-tight text-white hover:text-cyan">{l.label}</a>
      ))}
    </nav>
  </div>
</header>
