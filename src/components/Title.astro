---
// Titular con palabra clave en serif: el texto entre *asteriscos* va en Instrument Serif Italic.
// Cada palabra se envuelve para la animación de entrada (data-split).
interface Props { text: string; as?: 'h1' | 'h2' | 'h3'; class?: string }
const { text, as: Tag = 'h2', class: cls = '' } = Astro.props;
const parts = text.split(/(\*[^*]+\*)/).filter(Boolean).map((p) => ({ em: p.startsWith('*'), words: p.replace(/\*/g, '').split(/(\s+)/) }));
---
<Tag class={cls} data-split>
  {parts.map((p) => p.words.map((w) => (/^\s+$/.test(w) ? ' ' : w && (p.em ? <span class="w"><span><em class="k">{w}</em></span></span> : <span class="w"><span>{w}</span></span>))))}
</Tag>
