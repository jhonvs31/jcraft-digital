---
import { contact, services } from '../data/site';
import { u, wa } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden border-t border-white/10 bg-deep pt-20 pb-10">
  <div class="glow -bottom-60 left-1/2 h-[520px] w-[820px] -translate-x-1/2 opacity-40"></div>
  <div class="wrap relative">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <img src={u('assets/logo-white.png')} alt="JCraft Digital" width="150" height="48" class="h-11 w-auto" loading="lazy" />
        <p class="mt-5 max-w-xs text-white/65">Agencia de marketing digital especializada en pymes. Diseño, estrategia y tecnología para hacer crecer tu negocio en internet.</p>
        <div class="mt-6 flex gap-3">
          {[['Instagram', contact.instagram], ['Facebook', contact.facebook], ['LinkedIn', contact.linkedin], ['WhatsApp', wa('Hola!')]].map(([n, h]) => (
            <a href={h} target="_blank" rel="noopener" class="rounded-full border border-white/15 px-4 py-2 text-sm font-semibold text-white/80 transition hover:border-cyan hover:text-cyan">{n}</a>
          ))}
        </div>
      </div>
      <div>
        <h2 class="mb-5 text-sm tracking-[.2em] text-cyan uppercase">Servicios</h2>
        <ul class="space-y-3 text-white/70">{services.map((s) => <li><a href={u('servicios.html')} class="hover:text-white">{s.short}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="mb-5 text-sm tracking-[.2em] text-cyan uppercase">Empresa</h2>
        <ul class="space-y-3 text-white/70">
          <li><a href={u('nosotros.html')} class="hover:text-white">Sobre nosotros</a></li>
          <li><a href={u('portafolio.html')} class="hover:text-white">Portafolio</a></li>
          <li><a href={u('blog.html')} class="hover:text-white">Blog</a></li>
          <li><a href={u('contacto.html')} class="hover:text-white">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-5 text-sm tracking-[.2em] text-cyan uppercase">Contacto</h2>
        <ul class="space-y-3 text-white/70">
          <li><a href={`mailto:${contact.email}`} class="hover:text-white">{contact.email}</a></li>
          <li><a href={wa('Hola!')} target="_blank" rel="noopener" class="hover:text-white">{contact.phone}</a></li>
          <li>{contact.web}</li>
          <li>Colombia</li>
        </ul>
      </div>
    </div>
    <div class="mt-16 flex flex-col justify-between gap-3 border-t border-white/10 pt-8 text-sm text-white/45 sm:flex-row">
      <p>© {year} JCraft Digital — Todos los derechos reservados.</p>
      <p>Hecho por <strong class="text-white/70">JCraft Digital</strong></p>
    </div>
  </div>
</footer>
