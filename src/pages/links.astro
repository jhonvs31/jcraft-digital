---
import Logo from '../components/Logo.astro';
// Página de enlaces para la bio de Instagram (tipo Linktree).
// Cada enlace lleva UTM para medir en Google Analytics / Search Console las visitas que llegan desde Instagram.
import Base from '../layouts/Base.astro';
import posts from '../data/posts.json';
import { contact } from '../data/site';
import { u, wa } from '../lib/url';
import { Picture } from 'astro:assets';
import cata from '../assets/img/catalina.jpg';
import jhon from '../assets/img/jhon.jpg';

const utm = (path: string, content: string) => `${u(path)}?utm_source=instagram&utm_medium=bio&utm_campaign=linkinbio&utm_content=${content}`;
const latest = posts[0];
const links = [
  { href: wa('Hola JCraft! Vengo de Instagram y quiero una consulta gratuita.'), icon: '💬', title: 'Consulta gratuita por WhatsApp', sub: 'Respuesta en horario laboral', primary: true, ext: true },
  { href: utm('servicios.html', 'servicios'), icon: '🧭', title: 'Nuestros servicios', sub: 'Redes · Web · Pauta · Diseño · Estrategia' },
  { href: utm('portafolio.html', 'portafolio'), icon: '🗂️', title: 'Portafolio', sub: 'Proyectos en Colombia, México y EE. UU.' },
  { href: utm(`blog/${latest.slug}.html`, 'ultimo_articulo'), icon: latest.emoji, title: 'Nuevo en el blog', sub: latest.title },
  { href: utm('blog.html', 'blog'), icon: '📚', title: 'Blog: tips para pymes', sub: 'Marketing digital sin tecnicismos' },
  { href: utm('contacto.html', 'contacto'), icon: '✍️', title: 'Cuéntanos tu proyecto', sub: 'Formulario de contacto' },
  { href: `mailto:${contact.email}`, icon: '📧', title: 'Escríbenos un correo', sub: contact.email },
];
---
<Base title="Enlaces | JCraft Digital" description="Todos los enlaces de JCraft Digital: consulta gratuita por WhatsApp, servicios, portafolio, blog y contacto." page="links.html" noindex bare>
  <section class="lg-page relative min-h-[100svh] overflow-hidden px-5 py-14" data-lg>
    <!-- Fondo de color en movimiento: es lo que el vidrio refracta -->
    <div class="lg-bg" aria-hidden="true"><span class="lg-blob b1"></span><span class="lg-blob b2"></span><span class="lg-blob b3"></span><span class="lg-blob b4"></span></div>
    <!-- Filtro de refracción (solo lo usan los navegadores que lo soportan) -->
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
      <filter id="lg-refract" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.012" numOctaves="2" seed="7" result="n" />
        <feGaussianBlur in="n" stdDeviation="2" result="nb" />
        <feDisplacementMap in="SourceGraphic" in2="nb" scale="22" xChannelSelector="R" yChannelSelector="G" result="d" />
        <feComposite in="d" in2="SourceGraphic" operator="over" />
      </filter>
    </svg>

    <div class="relative mx-auto flex max-w-md flex-col items-center text-center">
      <div class="lg lg-card hero-in w-full px-6 pt-8 pb-7">
        <span class="lg-fx" aria-hidden="true"></span>
        <div class="flex justify-center">
          {[{ src: cata, alt: 'Catalina Escobar' }, { src: jhon, alt: 'Jhon Vega' }].map((p, i) => (
            <div class:list={['lg-avatar relative', i && '-ml-4']}>
              <Picture src={p.src} formats={['avif', 'webp']} widths={[112, 224, 336]} sizes="104px" quality={90} alt={`${p.alt}, cofundador${i ? '' : 'a'} de JCraft Digital`} class="relative h-26 w-26 rounded-full object-cover" loading="eager" />
            </div>
          ))}
        </div>
        <div class="mt-6 flex justify-center"><Logo class="h-10 w-auto" /></div>
        <h1 class="mt-4 text-3xl sm:text-4xl">Hacemos que tu negocio <em class="k">se vea</em></h1>
        <p class="mt-3 text-white/75">Diseño, marketing y tecnología para pymes · Colombia y LATAM</p>
      </div>

      <ul class="mt-5 w-full space-y-3.5" data-stagger>
        {links.map((l) => (
          <li data-reveal>
            <a href={l.href} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}
              class:list={['lg lg-link group flex w-full items-center gap-4 px-5 py-4 text-left', l.primary && 'lg-primary']}>
              <span class="lg-fx" aria-hidden="true"></span>
              <span class="lg-icon grid h-11 w-11 shrink-0 place-items-center text-xl" aria-hidden="true">{l.icon}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-display text-[17px] font-extrabold leading-tight">{l.title}</span>
                <span class:list={['mt-0.5 block truncate text-sm', l.primary ? 'text-navy/75' : 'text-white/65']}>{l.sub}</span>
              </span>
              <span class="text-lg transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex gap-3" data-reveal>
        {[['Facebook', contact.facebook], ['LinkedIn', contact.linkedin], ['Web', utm('index.html', 'web')]].map(([n, h]) => (
          <a href={h} target={n === 'Web' ? undefined : '_blank'} rel="noopener" class="lg lg-chip px-4 py-2 text-sm font-semibold text-white/90"><span class="lg-fx" aria-hidden="true"></span>{n}</a>
        ))}
      </div>
      <p class="mt-10 text-xs text-white/50">© {new Date().getFullYear()} JCraft Digital · {contact.phone}</p>
    </div>
  </section>
</Base>
