---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Title from '../components/Title.astro';
import posts from '../data/blog';
import { contact } from '../data/site';
import { u } from '../lib/url';
const featured = posts.find((p) => p.featured)!;
const rest = posts.filter((p) => !p.featured);
const filters = [{ id: 'all', label: 'Todos' }, { id: 'redes', label: 'Redes Sociales' }, { id: 'web', label: 'Diseño Web' }, { id: 'pauta', label: 'Pauta Digital' }, { id: 'marca', label: 'Marca' }, { id: 'seo', label: 'SEO' }, { id: 'estrategia', label: 'Estrategia' }];
---
<Base title="Blog de marketing digital para pymes | JCraft Digital" description="Tips, tendencias y estrategias de marketing digital para pymes, sin tecnicismos." page="blog.html" crumbs={[{ name: 'Blog', page: 'blog.html' }]}>
  <PageHero crumb="Blog" title="Blog *JCraft Digital*" text="Compartimos lo que sabemos para que tu negocio crezca. Tips, tendencias y estrategias de marketing digital sin tecnicismos." />

  <section class="bg-deep pb-20">
    <div class="wrap">
      <a href={u(`blog/${featured.slug}.html`)} data-reveal class="glass group relative grid gap-8 overflow-hidden p-8 sm:p-12 lg:grid-cols-[1.5fr_1fr]">
        <div class="glow -right-24 -top-24 h-96 w-96"></div>
        <div class="relative">
          <span class="eyebrow">⭐ Artículo destacado</span>
          <h2 class="mt-6 text-4xl leading-tight group-hover:text-cyan sm:text-5xl">{featured.title}</h2>
          <p class="mt-5 max-w-2xl text-lg text-white/70">{featured.excerpt}</p>
          <p class="mt-6 flex flex-wrap gap-5 text-sm font-semibold text-white/55"><span>📅 {featured.date}</span><span>⏱️ {featured.readTime} de lectura</span><span class="text-cyan">{featured.categoryName}</span></p>
          <span class="btn btn-primary mt-8">Leer artículo completo</span>
        </div>
        <div class="relative overflow-hidden rounded-3xl shadow-[0_30px_60px_-25px_rgba(0,0,0,.7)] lg:self-center"><img src={u(featured.cover)} alt="" decoding="async" width="1600" height="900" class="aspect-[16/9] w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
      </a>
    </div>
  </section>

  <section class="on-paper bg-paper py-24 text-navy sm:py-32">
    <div class="wrap">
      <div class="flex flex-wrap gap-3" data-filters="#articulos" role="group" aria-label="Filtrar artículos" data-reveal>
        {filters.map((f, i) => (
          <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'} class="rounded-full border-2 border-navy/15 px-5 py-2.5 font-bold transition hover:border-navy aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white">{f.label}</button>
        ))}
      </div>
      <div id="articulos" class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-stagger>
        {rest.map((p) => (
          <a href={u(`blog/${p.slug}.html`)} data-cat={p.category} data-reveal class="card-paper group flex flex-col overflow-hidden transition hover:-translate-y-1">
            <div class="aspect-[16/9] overflow-hidden bg-navy"><img src={u(p.cover)} alt="" loading="lazy" decoding="async" width="1600" height="900" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
            <div class="flex flex-1 flex-col p-7">
            <p class="text-xs font-extrabold tracking-[.18em] text-blue uppercase">{p.categoryName}</p>
            <h2 class="mt-3 text-2xl leading-tight group-hover:text-blue">{p.title}</h2>
            <p class="mt-3 flex-1 text-navy/65">{p.excerpt}</p>
            <p class="mt-6 flex justify-between text-sm font-semibold text-navy/50"><span>📅 {p.date} · {p.readTime}</span><span class="text-blue">Leer →</span></p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-deep py-24 text-center sm:py-32">
    <div class="wrap max-w-3xl">
      <span class="eyebrow" data-reveal>Más contenido</span>
      <Title text="Tips de marketing digital *cada semana*" class="mt-6 text-5xl sm:text-6xl" />
      <p class="mt-6 text-lg text-white/70" data-reveal>Publicamos ideas prácticas para pymes en Instagram. Síguenos y no te pierdas ninguna.</p>
      <a href={contact.instagram} target="_blank" rel="noopener" class="btn btn-primary mt-10" data-reveal data-magnetic>Seguir a @jcraftdigital</a>
    </div>
  </section>
</Base>
