---
import { seo } from '../data/site';
// Política de privacidad y tratamiento de datos personales (Ley 1581 de 2012 y Decreto 1074 de 2015, Colombia)
// y uso de cookies (Google Analytics y Google Ads). Si cambias algo importante, actualiza la fecha en el panel.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { contact } from '../data/site';
// El texto se edita desde el panel (Ajustes → Política de privacidad): src/content/paginas/privacidad.md
import { marked } from 'marked';
import YAML from 'yaml';
import raw from '../content/paginas/privacidad.md?raw';
const [, fm = '', body = ''] = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/) ?? [];
const updated = String(YAML.parse(fm)?.actualizado ?? '');
const html = (marked.parse(body.replaceAll('{{correo}}', contact.email).replaceAll('{{telefono}}', contact.phone).replaceAll('{{fecha}}', updated), { async: false }) as string)
  // [texto](#preferencias-cookies) abre el panel de cookies; los enlaces externos se abren en otra pestaña.
  .replaceAll('href="#preferencias-cookies"', 'href="#" data-cookie-settings')
  .replace(/<a href="(https?:\/\/[^"]+)">/g, '<a href="$1" target="_blank" rel="noopener">');
---
<Base title={seo.privacidad.titulo} description={seo.privacidad.descripcion} page="privacidad.html" crumbs={[{ name: 'Política de privacidad', page: 'privacidad.html' }]}>
  <PageHero crumb="Política de privacidad" title="Política de *privacidad*" text={`Cómo recogemos, usamos y protegemos tus datos personales. Última actualización: ${updated}.`} />

  <div class="bg-paper py-16 sm:py-24">
    <div class="prose-jc wrap max-w-3xl" set:html={html} />
  </div>
</Base>
