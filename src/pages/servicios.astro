---
import { seo } from '../data/site';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Title from '../components/Title.astro';
import Cta from '../components/Cta.astro';
import { services, faq, socialPlans, webPlans, webCare, otherPricing } from '../data/site';
import { u, wa } from '../lib/url';
const cop = (n: number) => n.toLocaleString('es-CO');
const schema = [
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ...services.map((s) => ({ '@type': 'Service', name: s.title, description: s.text, serviceType: s.short, provider: { '@id': new URL('#org', new URL(u(''), Astro.site)).href }, areaServed: 'CO' })),
];
---
<Base title={seo.servicios.titulo} description={seo.servicios.descripcion} page="servicios.html" crumbs={[{ name: 'Servicios', page: 'servicios.html' }]} schema={schema}>
  <PageHero crumb="Servicios" title="Nuestros *servicios*" text="Todo lo que tu negocio necesita para crecer en el mundo digital, en un solo lugar." />

  <section class="bg-deep pb-10">
    <div class="wrap">
      <a href={u('test.html')} data-quiz-open data-reveal class="glass group relative flex flex-col gap-6 overflow-hidden p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10">
        <div class="glow -right-20 -top-24 h-72 w-72"></div>
        <div class="relative"><p class="text-xs font-extrabold tracking-[.18em] text-cyan uppercase">Test gratis · 60 segundos</p><p class="mt-3 font-display text-3xl font-black sm:text-4xl">¿No sabes por dónde empezar? <em class="k">Haz el test.</em></p><p class="mt-2 text-white/65">7 preguntas y te decimos qué servicio y qué plan le conviene a tu negocio.</p></div>
        <span class="btn btn-primary relative shrink-0">Hacer el test →</span>
      </a>
    </div>
  </section>

  <section class="bg-deep pb-28 sm:pb-36">
    <div class="wrap space-y-6">
      {services.map((s, i) => (
        <article id={`servicio-${s.n}`} data-reveal class:list={['relative grid gap-10 overflow-hidden rounded-[32px] p-8 sm:p-12 lg:grid-cols-[1fr_1.1fr]', i % 2 ? 'bg-paper text-navy on-paper' : 'glass']}>
          <div class="glow -right-32 -top-32 h-96 w-96 opacity-50"></div>
          <div class="relative">
            <div class="flex items-center gap-5"><span class="num-out text-7xl sm:text-8xl">{s.n}</span><span class="text-5xl" aria-hidden="true">{s.icon}</span></div>
            <h2 class="mt-8 text-4xl sm:text-5xl">{s.title}</h2>
            <p class:list={['mt-5 max-w-lg text-lg', i % 2 ? 'text-navy/70' : 'text-white/70']}>{s.text}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={u('contacto.html')} class={i % 2 ? 'btn btn-navy' : 'btn btn-primary'} data-magnetic>Pedir información</a>
              <a href={wa(`Hola! Quiero consultar el precio de: ${s.title}.`)} target="_blank" rel="noopener" class={i % 2 ? 'btn border-2 border-navy text-navy' : 'btn btn-ghost'}>Consultar precio</a>
            </div>
          </div>
          <ul class="relative grid content-center gap-3 sm:grid-cols-2">
            {s.items.map((it) => (
              <li class:list={['flex items-start gap-3 rounded-2xl p-4 font-semibold', i % 2 ? 'bg-white text-navy' : 'bg-white/[.06]']}>
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-cyan text-xs font-black text-navy" aria-hidden="true">✓</span>{it}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="precios" class="bg-deep pb-28 sm:pb-36" data-currency="cop">
    <div class="wrap">
      <span class="eyebrow" data-reveal>Precios</span>
      <Title text="Planes claros, *sin sorpresas*" class="mt-6 max-w-3xl text-5xl sm:text-6xl" />
      <div class="mt-8 flex flex-wrap items-center gap-4" data-reveal>
        <span class="text-white/70">Ver precios en</span>
        <div class="inline-flex rounded-full border border-white/20 bg-white/5 p-1" role="group" aria-label="Moneda de los precios">
          <button type="button" data-cur-btn="cop" aria-pressed="true" class="rounded-full px-5 py-2 font-display text-sm font-extrabold tracking-[.12em] text-white/70 transition aria-pressed:bg-cyan aria-pressed:text-navy">COP</button>
          <button type="button" data-cur-btn="usd" aria-pressed="false" class="rounded-full px-5 py-2 font-display text-sm font-extrabold tracking-[.12em] text-white/70 transition aria-pressed:bg-cyan aria-pressed:text-navy">USD</button>
          <button type="button" data-cur-btn="eur" aria-pressed="false" class="rounded-full px-5 py-2 font-display text-sm font-extrabold tracking-[.12em] text-white/70 transition aria-pressed:bg-cyan aria-pressed:text-navy">EUR</button>
        </div>
      </div>

      <h3 class="mt-16 text-3xl sm:text-4xl" data-reveal>Redes sociales <span class="text-white/50">· al mes</span></h3>
      <div class="mt-8 grid gap-5 lg:grid-cols-3" data-stagger>
        {socialPlans.map((p) => (
          <article data-reveal class:list={['relative flex flex-col p-8', p.featured ? 'card-paper on-paper ring-4 ring-cyan' : 'glass']}>
            {p.featured && <span class="absolute -top-4 left-8 rounded-full bg-cyan px-4 py-1.5 text-xs font-extrabold tracking-[.18em] text-navy uppercase">Recomendado</span>}
            <h4 class="text-2xl">{p.name}</h4>
            <p class="mt-4 flex flex-wrap items-baseline gap-x-2"><span data-cur-label class:list={['text-sm font-extrabold tracking-[.18em]', p.featured ? 'text-navy/60' : 'text-white/60']}>COP</span><span data-cop={`$${cop(p.cop)}`} data-usd={String(p.price)} data-eur={String(p.eur)} class="font-display text-5xl font-black tracking-tight tabular-nums sm:text-6xl lg:text-5xl xl:text-6xl">${cop(p.cop)}</span><span class:list={[p.featured ? 'text-navy/60' : 'text-white/60']}>/mes</span></p>
            <p class:list={['mt-2 font-bold', p.featured ? 'text-blue' : 'text-cyan']}>{p.total} contenidos al mes</p>
            <ul class:list={['mt-6 grid gap-2.5 border-t pt-6', p.featured ? 'border-navy/10' : 'border-white/10']}>
              {p.items.map((it) => (
                <li class="flex items-start gap-3"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-cyan text-[10px] font-black text-navy" aria-hidden="true">✓</span>{it}</li>
              ))}
            </ul>
            <a href={wa(`Hola! Me interesa el plan ${p.name} de redes sociales.`)} target="_blank" rel="noopener" class:list={['btn mt-8', p.featured ? 'btn-navy' : 'btn-primary']}>Quiero este plan</a>
          </article>
        ))}
      </div>
      <p class="mt-6 max-w-3xl text-white/60" data-reveal>No incluye el presupuesto de anuncios pagados, sesiones de fotos ni la respuesta a mensajes y comentarios.</p>

      <h3 class="mt-20 text-3xl sm:text-4xl" data-reveal>Páginas web <span class="text-white/50">· pago único</span></h3>
      <div class="mt-8 grid gap-5 md:grid-cols-2" data-stagger>
        {webPlans.map((p) => (
          <article data-reveal class="glass flex flex-col p-8">
            <h4 class="text-2xl">{p.name}</h4>
            <p class="mt-4 flex flex-wrap items-baseline gap-x-2"><span class="text-sm font-extrabold tracking-[.18em] text-white/60">DESDE <span data-cur-label>COP</span></span><span data-cop={`$${cop(p.cop)}`} data-usd={String(p.price)} data-eur={String(p.eur)} class="font-display text-5xl font-black tracking-tight tabular-nums sm:text-6xl">${cop(p.cop)}</span></p>
            <p class="mt-3 text-white/70">{p.text}</p>
            <ul class="mt-6 grid gap-2.5 border-t border-white/10 pt-6">
              {p.items.map((it) => (
                <li class="flex items-start gap-3"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-cyan text-[10px] font-black text-navy" aria-hidden="true">✓</span>{it}</li>
              ))}
            </ul>
            <a href={wa(`Hola! Quiero cotizar: ${p.name}.`)} target="_blank" rel="noopener" class="btn btn-primary mt-8 self-start">Cotizar mi {p.name.toLowerCase()}</a>
          </article>
        ))}
      </div>
      <div data-reveal class="glass mt-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 p-6 sm:p-8">
        <div class="min-w-0 max-w-xl">
          <h4 class="text-xl">{webCare.name} <span class="font-sans text-base font-normal text-white/60">· opcional</span></h4>
          <p class="mt-2 text-white/70">{webCare.text}</p>
        </div>
        <p class="flex flex-wrap items-baseline gap-x-2"><span data-cur-label class="text-sm font-extrabold tracking-[.18em] text-white/60">COP</span><span data-cop={`$${cop(webCare.cop)}`} data-usd={String(webCare.price)} data-eur={String(webCare.eur)} class="font-display text-4xl font-black tracking-tight tabular-nums">${cop(webCare.cop)}</span><span class="text-white/60">/mes</span></p>
      </div>
      <p class="mt-6 max-w-3xl text-white/60" data-reveal>El hosting y el dominio tienen un costo aparte. El precio final depende de lo que necesite tu proyecto; te lo confirmamos antes de empezar.</p>

      {otherPricing.map((g) => (
        <>
          <h3 class="mt-20 text-3xl sm:text-4xl" data-reveal>{g.title} <span class="text-white/50">· {g.period}</span></h3>
          <div class:list={["mt-8 grid gap-5 md:grid-cols-2", g.plans.length === 3 && "lg:grid-cols-3"]} data-stagger>
            {g.plans.map((p) => (
              <article data-reveal class="glass flex flex-col p-8">
                <h4 class="text-2xl">{p.name}</h4>
                {'free' in p && p.free
                  ? <p class="mt-4 flex flex-wrap items-baseline gap-x-2"><span class="font-display text-5xl font-black tracking-tight text-cyan">Gratis</span><span class="text-white/60">sin compromiso</span></p>
                  : <p class="mt-4 flex flex-wrap items-baseline gap-x-2"><span class="text-sm font-extrabold tracking-[.18em] text-white/60">{p.from && 'DESDE '}<span data-cur-label>COP</span></span><span data-cop={`$${cop(p.cop)}`} data-usd={String(p.price)} data-eur={String(p.eur)} class:list={["font-display text-5xl font-black tracking-tight tabular-nums", g.plans.length === 3 && "lg:text-4xl xl:text-5xl"]}>${cop(p.cop)}</span>{p.unit && <span class="text-white/60">{p.unit}</span>}</p>}
                <ul class="mt-6 grid gap-2.5 border-t border-white/10 pt-6">
                  {p.items.map((it) => (
                    <li class="flex items-start gap-3"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-cyan text-[10px] font-black text-navy" aria-hidden="true">✓</span>{it}</li>
                  ))}
                </ul>
                {'free' in p && p.free
                  ? <button type="button" data-diag-open class="btn btn-primary mt-8 self-start">Pedir mi diagnóstico gratis</button>
                  : <a href={wa(`Hola! Me interesa: ${p.name}.`)} target="_blank" rel="noopener" class="btn btn-ghost mt-8 self-start">Lo quiero</a>}
              </article>
            ))}
          </div>
          {g.note && <p class="mt-6 max-w-3xl text-white/60" data-reveal>{g.note}</p>}
        </>
      ))}
    </div>
  </section>

  <section class="on-paper bg-paper py-28 text-navy sm:py-36">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.4fr]">
      <div><span class="eyebrow" data-reveal>Preguntas frecuentes</span><Title text="Todo lo que *quieres saber*" class="mt-6 text-5xl sm:text-6xl" /></div>
      <div class="space-y-3" data-stagger>
        {faq.map((f, i) => (
          <details class="faq card-paper group p-6" data-reveal open={i === 0}>
            <summary class="flex items-center justify-between gap-6 font-display text-xl font-extrabold">{f.q}
              <span class="faq-plus grid h-10 w-10 shrink-0 place-items-center rounded-full bg-navy/5 text-2xl transition" aria-hidden="true">+</span></summary>
            <p class="mt-4 text-lg text-navy/70">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script is:inline src={u('assets/js/currency.js') + '?v=2'} defer></script>

  <Cta title="¿No sabes *por dónde empezar?*" text="Te ayudamos a identificar qué necesita tu negocio. Consulta gratuita, sin compromiso." primary="Agendar consulta gratuita" waText="Hola! Quiero consultar sobre sus servicios." waLabel="WhatsApp directo" />
</Base>
